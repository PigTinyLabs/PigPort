{
  "name": "playbridge",
  "productName": "PigPort",
  "version": "0.2.3",
  "description": "PigPort by PigTinyLabs: play iOS and Android games on Mac and Windows with keyboard and mouse",
  "main": "dist/main/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs && node scripts/build-ios-input.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "fetch:scrcpy-server": "node scripts/fetch-scrcpy-server.mjs",
    "dist:mac": "npm run build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "setup:electron": "node node_modules/electron/install.js",
    "test:ipa-native": "npm run build && node scripts/test-native-ipa.mjs",
    "build:ios-input": "node scripts/build-ios-input.mjs --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15"
  }
}
