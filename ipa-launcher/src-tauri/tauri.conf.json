{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PigPort IPA",
  "version": "../package.json",
  "identifier": "com.pigtinylabs.pigport.ipa",
  "build": {
    "beforeBuildCommand": "npm run build:worker",
    "beforeDevCommand": "npm run build:worker",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "PigPort IPA",
      "width": 1000,
      "height": 710,
      "minWidth": 640,
      "minHeight": 520,
      "backgroundColor": "#141319"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "externalBin": ["binaries/pigport-ipa-worker", "binaries/pigport-ipa-ipatool"],
    "resources": {"runtime-assets/": "runtime-assets/"},
    "icon": ["../../build/icon.png", "../../build/icon.icns"],
    "macOS": {"minimumSystemVersion": "13.5", "signingIdentity": "-"}
  }
}
